<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for your specific EC2 domain -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ec2-65-2-170-60.ap-south-1.compute.amazonaws.com</domain>
    </domain-config>
    
    <!-- Allow all cleartext traffic for debugging (use only during development) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>